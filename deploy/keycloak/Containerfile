FROM quay.io/keycloak/keycloak:26.7.2 AS builder

ENV KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true \
    KC_DB=postgres \
    KC_HTTP_MANAGEMENT_HEALTH_ENABLED=false

WORKDIR /opt/keycloak
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.7.2

LABEL org.opencontainers.image.title="AIRenOS Authentication Engine" \
      org.opencontainers.image.description="Self-hosted replaceable Keycloak authentication engine for AIRenOS Identity & Session Authority" \
      org.opencontainers.image.version="26.7.2"

ENV KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true \
    KC_DB=postgres \
    KC_HTTP_MANAGEMENT_HEALTH_ENABLED=false

COPY --from=builder /opt/keycloak/ /opt/keycloak/

# Render SSH requires a writable ~/.ssh for the runtime user and a real shell.
# The upstream Keycloak image runs as uid 1000 with HOME=/opt/keycloak and
# /sbin/nologin. Change only those SSH compatibility properties, then restore
# the original non-root runtime uid.
USER 0
RUN mkdir -p /opt/keycloak/.ssh \
    && chmod 0700 /opt/keycloak/.ssh \
    && chown 1000:0 /opt/keycloak/.ssh \
    && sed -i 's#^keycloak:x:1000:0:keycloak user:/opt/keycloak:/sbin/nologin$#keycloak:x:1000:0:keycloak user:/opt/keycloak:/bin/sh#' /etc/passwd
USER 1000

ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized"]
