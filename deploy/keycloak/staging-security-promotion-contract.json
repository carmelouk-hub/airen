{
  "contract": "AIRenOS Identity Staging Security Promotion and Session Handoff",
  "version": "0.1",
  "date": "2026-08-31",
  "scope": "STATIC_GOVERNED_CONTRACT_ONLY",
  "authority_boundary": {
    "keycloak_authentication_engine_replaceable": true,
    "keycloak_is_airenos_identity_authority": false,
    "keycloak_roles_tenants_entitlements_are_airenos_authority": false,
    "upstream_provider_token_is_airenos_bearer": false,
    "base44_authentication_is_airenos_authority": false,
    "airenos_identity_directory_is_canonical": true,
    "airenos_session_authority_is_canonical": true,
    "authorization_before_kairos_retrieval_required": true,
    "browser_asserted_tenant_role_scope_authoritative": false
  },
  "secret_kms_boundary": {
    "binding_status": "OPEN_NOT_EXECUTED",
    "candidate_secret_provider": "OVHCLOUD_SECRET_MANAGER_BEHIND_AIRENOS_ADAPTER",
    "candidate_key_provider": "OVHCLOUD_KMS",
    "live_region_capability_and_iam_proof_required": true,
    "workload_identity_mechanism": "TBD_AFTER_LIVE_MKS_IAM_READBACK",
    "logical_runtime_material": [
      "keycloak_database_url",
      "keycloak_database_username",
      "keycloak_database_password",
      "keycloak_bootstrap_admin_username",
      "keycloak_bootstrap_admin_password",
      "registry_pull_credential_if_required",
      "tls_private_key_material"
    ],
    "airenos_session_signing_key_owner": "AIRENOS_SESSION_AUTHORITY_NOT_KEYCLOAK",
    "raw_secret_values_prohibited_in": [
      "GIT",
      "GOOGLE_DRIVE",
      "BASE44",
      "COMMITTED_TERRAFORM_INPUTS_OR_STATE_DESIGNED_BY_THIS_GATE",
      "OCI_IMAGE_LAYERS",
      "CI_LOGS",
      "CHAT"
    ],
    "kubernetes_secret_values_committed": false,
    "provider_binding_may_be_claimed_from_static_contract": false
  },
  "immutable_image_promotion": {
    "status": "OPEN_NOT_EXECUTED",
    "source_containerfile": "deploy/keycloak/Containerfile",
    "source_keycloak_image": "quay.io/keycloak/keycloak:26.7.2",
    "registry_target": "LIVE_PROVIDER_BOUND_TARGET_REQUIRED",
    "tag_only_deployment_forbidden": true,
    "required_deployment_reference_form": "registry/repository@sha256:<64-lowercase-hex>",
    "promoted_digest_source": "DIGEST_FROM_PUSHED_ARTIFACT_PLUS_INDEPENDENT_REGISTRY_READBACK",
    "local_docker_image_id_is_promotion_proof": false,
    "upstream_base_image_digest_is_promoted_airenos_digest": false,
    "build_provenance_required": true,
    "registry_vulnerability_scan_required": true,
    "unresolved_critical_findings_allowed_by_default": false,
    "unresolved_high_findings_require_explicit_security_acceptance": true,
    "private_registry_region_capability_readback_required": true,
    "registry_push_executed": false,
    "registry_digest_readback_executed": false
  },
  "dns_tls_boundary": {
    "status": "OPEN_NOT_PROVEN",
    "public_login_hostname": "login.airenos.com",
    "restricted_admin_hostname": "identity-admin.airenos.com",
    "session_callback_hostname": "session.airenos.com",
    "session_callback_uri": "https://session.airenos.com/oidc/callback",
    "exact_dns_provider_readback_required": true,
    "publicly_trusted_tls_chain_required_for_public_endpoints": true,
    "certificate_san_readback_required": true,
    "tls_private_key_must_remain_in_secret_kms_boundary": true,
    "admin_surface_network_restriction_required": true,
    "admin_public_exposure_authorized": false,
    "external_https_required": true,
    "internal_http_allowed_only_behind_verified_trusted_proxy_boundary": true,
    "hsts_preload_authorized": false,
    "dns_changes_executed": false,
    "certificate_issuance_executed": false
  },
  "session_handoff": {
    "status": "OPEN_RUNTIME_PROOF_REQUIRED",
    "browser_to_keycloak": "OIDC_AUTHORIZATION_CODE_WITH_PKCE_S256",
    "callback": "https://session.airenos.com/oidc/callback",
    "provider_verification": "AIRENOS_F2_OIDC_ADAPTER",
    "canonical_identity_resolution": "AIRENOS_IDENTITY_DIRECTORY",
    "session_issuance": "AIRENOS_ED25519_SESSION_AUTHORITY",
    "kairos_authorization": "AIRENOS_AUTHORIZATION_BEFORE_RETRIEVAL",
    "keycloak_access_token_forwarded_as_airenos_bearer": false,
    "keycloak_role_or_tenant_claims_imported_as_authority": false,
    "base44_preview_localstorage_authority": false,
    "base44_exact_origin_handoff_boundary_preserved": true,
    "real_provider_authorization_code_exchange_required": true,
    "real_browser_login_required": true,
    "base44_to_airenos_to_kairos_authenticated_e2e_required": true,
    "simulated_evidence_can_close_gate": false
  },
  "live_evidence": {
    "secret_manager_kms_binding": false,
    "immutable_keycloak_image_promoted": false,
    "registry_digest_readback": false,
    "dns_proven": false,
    "tls_proven": false,
    "keycloak_staging_deployed": false,
    "realm_client_live_readback": false,
    "real_provider_authorization_code_exchange": false,
    "real_browser_login": false,
    "base44_airenos_kairos_authenticated_e2e": false,
    "k4_c3_runtime_deploy_session_handoff_proof": false
  },
  "external_dependency": {
    "ovh_account_onboarding": "PAUSED_EXTERNAL_FISCAL_DATA_PENDING",
    "real_provider_apply_authorized": false,
    "billable_resource_creation_authorized": false
  }
}
