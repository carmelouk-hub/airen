FROM node:22-bookworm-slim AS runtime-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund --workspaces=false \
    && npm cache clean --force

FROM node:22-bookworm-slim
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="AIRenOS Identity Session Authority F2.3 Staging" \
      org.opencontainers.image.description="Temporary non-production Render execution adapter for the provider-neutral AIRenOS Session Authority" \
      org.opencontainers.image.version="f2.3" \
      org.opencontainers.image.revision="$VCS_REF"
ENV HOST=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=runtime-deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY deploy ./deploy
RUN mkdir -p /var/data/airenos-session && chown -R node:node /var/data/airenos-session
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||'3000')+'/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node","--experimental-strip-types","deploy/session-authority-runtime-entry.ts"]
